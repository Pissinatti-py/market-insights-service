# Copy to .env. Defaults below target the standalone docker-compose stack.

# App
APP_NAME="Market Insights Service"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true
API_PREFIX=/api
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# Postgres (this service owns its own DB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=market_insights
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/market_insights

# Redis — cache + Celery broker/result backend + redbeat schedule store
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# GitHub Search API. A token lifts the rate limit from 10 to 30 req/min and is
# effectively required for the trending collector. https://github.com/settings/tokens
GITHUB_TOKEN=

# LLM curation — local Ollama daemon over plain HTTP (no SDK). Swap OLLAMA_BASE_URL
# for any OpenAI-compatible /api/chat endpoint to change providers.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:14b-q8_0
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Collector knobs
COLLECTOR_HTTP_TIMEOUT_SECONDS=30
GITHUB_MAX_RESULTS=50
# Per-run safety cap — curation drains the whole backlog up to this many items per run
CURATION_BATCH_SIZE=200

# LinkedIn — best-effort, OFF by default (no stable public API; scraping breaks
# and risks ToS). When enabled, supply a session cookie at your own risk.
ENABLE_LINKEDIN=false
LINKEDIN_COOKIE=
LINKEDIN_MAX_POSTS=25

# Shared secret for future east-west wiring into the another microsservice network (sent as
# X-Internal-Token). Unused while standalone. Not Required
INTERNAL_TOKEN=dev-internal-token
