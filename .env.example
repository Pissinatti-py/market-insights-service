# Copy to .env. Defaults below target the standalone docker-compose stack.

# App
APP_NAME="Market Insights Service"
APP_VERSION="0.1.0"
API_PREFIX=/api
ALLOWED_ORIGINS=*

# Postgres (this service owns its own DB). POSTGRES_* configure the compose
# container; the app itself connects with DATABASE_URL only — change both together.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=market_insights
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/market_insights

# Redis — cache + Celery broker/result backend + redbeat schedule store
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# GitHub Search API. A token lifts the rate limit from 10 to 30 req/min and is
# effectively required for the trending collector. https://github.com/settings/tokens
GITHUB_TOKEN=

# LLM curation — local Ollama daemon over plain HTTP (no SDK). Swap OLLAMA_BASE_URL
# for any OpenAI-compatible /api/chat endpoint to change providers.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:14b-q8_0
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
# Embedding model for the importance ranker — `ollama pull bge-m3` on the daemon host.
OLLAMA_EMBED_MODEL=bge-m3

# Collector knobs
COLLECTOR_HTTP_TIMEOUT_SECONDS=30
GITHUB_MAX_RESULTS=50
# Per-run safety cap — curation is chained after each collector, so runs stay small
CURATION_BATCH_SIZE=50
# Articles older than this never enter the pipeline
ARTICLE_MAX_AGE_DAYS=14
